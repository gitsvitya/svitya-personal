{
  "name": "svitya-personal",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "next": "^16.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "vitest run src/content/portfolio/content.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run validate:content && npm run lint && npm run typecheck && npm run test && npm run format:check"
  }
}
